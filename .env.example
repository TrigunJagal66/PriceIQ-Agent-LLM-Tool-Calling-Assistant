# Any OpenAI-compatible chat-completions endpoint works (Groq, Gemini, OpenAI, Ollama, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=llama-3.3-70b-versatile

# PriceIQ forecasting API (https://github.com/TrigunJagal66/hotel-demand-pricing)
PRICEIQ_URL=http://127.0.0.1:8000
DEMAND_CSV=data/daily_demand.csv
MAX_STEPS=6
